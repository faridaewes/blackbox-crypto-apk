# ============================================================
# BLACKBOX Crypto — konfigurasi. Jalankan `npm run setup` untuk membuat
# file .env dari template ini dengan rahasia acak. JANGAN commit .env.
# ============================================================
NEXT_PUBLIC_APP_NAME=BLACKBOX Crypto
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Android APK is served from the fixed public path: /downloads/BLACKBOX-Crypto-Android.apk
# No Android download URL environment variable is required. Replace the APK file only for future updates.

# --- Database (PostgreSQL) ---
POSTGRES_PASSWORD=isi-lewat-npm-run-setup
DATABASE_URL=postgresql://blackbox:isi-lewat-npm-run-setup@localhost:5432/blackbox

# --- Keamanan (WAJIB: diisi otomatis oleh `npm run setup`) ---
# AUTH_SECRET: >= 32 karakter acak.   DATA_ENCRYPTION_KEY: 64 karakter hex (openssl rand -hex 32)
AUTH_SECRET=isi-lewat-npm-run-setup
DATA_ENCRYPTION_KEY=isi-lewat-npm-run-setup
# Akun bootstrap dibuat otomatis oleh prisma/seed.ts pada install pertama:
# Developer: developer@blackbox.com / @blackbox123
# Admin:     admin@blackbox.com / @adminblackbox123
# Keduanya wajib mengganti password setelah login pertama.
# Opsional untuk deployment production/private: override bootstrap password sebelum first seed.
DEVELOPER_SEED_PASSWORD=
ADMIN_SEED_PASSWORD=
# Setel false HANYA bila Anda mengakses lewat http://IP (tanpa HTTPS); kalau tidak, login tidak akan tersimpan.
COOKIE_SECURE=true
# Set true only when Railway/Nginx/Cloudflare is your trusted reverse proxy.
TRUST_PROXY=true

# --- AI (pilih satu; kosongkan AI_API_KEY = mesin aturan lokal, tetap berjalan) ---
# OpenRouter (gratis, model :free atau router openrouter/free):
AI_PROVIDER=local-fallback
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openrouter/free
# Groq (gratis, OpenAI-compatible):  AI_PROVIDER=openai-compatible
#   AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=openai/gpt-oss-120b
# Ollama lokal (tanpa kuota, butuh RAM): AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Pembatas agar kuota gratis tidak habis (OpenRouter gratis: 20 req/menit, 50 req/hari tanpa kredit)
AI_DAILY_BUDGET=40
AI_PER_MINUTE=12
AI_MAX_PER_CYCLE=2
AI_CACHE_MIN=15

# --- Data pasar ---
# auto = DexScreener (gratis, tanpa key); bila gagal otomatis pakai simulasi. live | sim | auto
MARKET_MODE=auto
DEXSCREENER_BASE_URL=https://api.dexscreener.com

# --- Router (paper secara default) ---
ROUTER_MODE=paper
ZEROX_API_KEY=
JUPITER_API_KEY=

# --- Notifikasi (opsional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
TELEGRAM_BOT_TOKEN=

# --- Worker ---
PAPER_ENGINE_INTERVAL_MS=10000

# --- REAL trading: default OFF. Enable only after exchange-specific certification. ---
REAL_TRADING_ENABLED=false
REAL_TRADING_PRODUCTION_READY=false
REAL_CERTIFICATION_MODE=false
# Comma-separated exchanges that have completed your sandbox/small-notional certification.
REAL_CERTIFIED_EXCHANGES=
# Optional market intelligence provider returning fundingRate/openInterest/liquidationsUsd/newsRisk/news
MARKET_INTELLIGENCE_URL=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Private KYC encrypted document storage
KYC_PRIVATE_DIR=./private-kyc

TELEGRAM_DEFAULT_CHAT_ID=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_TO=

# --- Exchange / execution hardening ---
MARKET_EXCHANGE=binance
EXCHANGE_REQUEST_TIMEOUT_MS=15000
REAL_AI_MAX_PER_CYCLE=2
RETENTION_AGENT_LOG_DAYS=3
RETENTION_AI_CALL_DAYS=14
RETENTION_RISK_EVENT_DAYS=30
RETENTION_ACTIVITY_DAYS=90
RETENTION_ADMIN_ACTIVITY_DAYS=180
RETENTION_NOTIFICATION_DAYS=90
RETENTION_AUDIT_DAYS=730
RETENTION_RECONCILIATION_DAYS=30
RETENTION_SIGNAL_DAYS=180

# Wallets
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_WALLET_APP_NAME=BLACKBOX Crypto
WALLETCONNECT_PROJECT_ID=
WALLET_APP_URL=http://localhost:3000
WALLET_APP_NAME=BLACKBOX Crypto
